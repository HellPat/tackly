<?xml version="1.0" encoding="utf-8"?>
<!-- The three ticked dots, drawn from icon.svg's 100-unit picture, shrunk to the
     middle of the 108 dp canvas so that every shape the phone cuts keeps it whole
     (only the middle 72 dp always shows). Circles are arcs: vectors have none. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="53"
        android:pivotY="52.5"
        android:scaleX="0.75"
        android:scaleY="0.75"
        android:translateX="1"
        android:translateY="1.5">
        <!-- the connector -->
        <path
            android:pathData="M27,53 L44,69 L73,36"
            android:strokeColor="#66FFFFFF"
            android:strokeWidth="6"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <!-- the dots -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M18,53 a9,9 0 1,0 18,0 a9,9 0 1,0 -18,0 z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M33,69 a11,11 0 1,0 22,0 a11,11 0 1,0 -22,0 z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M58,36 a15,15 0 1,0 30,0 a15,15 0 1,0 -30,0 z" />
        <!-- the ticks -->
        <path
            android:pathData="M23.4,53.3 L26.1,56 L31.2,50"
            android:strokeColor="#BE185D"
            android:strokeWidth="2.8"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M39.6,69.4 L42.9,72.7 L49.1,65.3"
            android:strokeColor="#BE185D"
            android:strokeWidth="3.4"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M67,36.5 L71.5,41 L80,31"
            android:strokeColor="#BE185D"
            android:strokeWidth="4.6"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
